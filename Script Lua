local function SendNotification(title, text)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 50)
    card.BackgroundColor3 = Color3.fromRGB(10, 14, 22)
    card.BackgroundTransparency = 0.1
    card.Parent = NotifContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = card

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 230, 255)
    stroke.Thickness = 1
    stroke.Parent = card

    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -16, 0, 20)
    tLabel.Position = UDim2.new(0, 8, 0, 4)
    tLabel.BackgroundTransparency = 1
    tLabel.Text = title
    tLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
    tLabel.TextSize = 11
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = card

    local mLabel = Instance.new("TextLabel")
    mLabel.Size = UDim2.new(1, -16, 0, 20)
    mLabel.Position = UDim2.new(0, 8, 0, 22)
    mLabel.BackgroundTransparency = 1
    mLabel.Text = text
    mLabel.TextColor3 = Color3.fromRGB(200, 220, 240)
    mLabel.TextSize = 10
    mLabel.Font = Enum.Font.Gotham
    mLabel.TextXAlignment = Enum.TextXAlignment.Left
    mLabel.Parent = card

    task.delay(3, function()
        TweenService:Create(card, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        task.wait(0.3)
        card:Destroy()
    end)
end

