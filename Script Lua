    local currentTab = "Warp"
    local TabWarp, TabSystem

    local function SwitchTab(tabName)
        if tabName == currentTab then return end
        currentTab = tabName
        
        if tabName == "Warp" then
            TweenService:Create(TabWarp, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 220, 255)}):Play()
            TweenService:Create(TabSystem, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(12, 18, 30)}):Play()
            WarpContainer.Visible = true
            SystemContainer.Visible = false
        else
            TweenService:Create(TabSystem, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 220, 255)}):Play()
            TweenService:Create(TabWarp, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(12, 18, 30)}):Play()
            WarpContainer.Visible = false
            SystemContainer.Visible = true
        end
    end

    TabWarp = CreateTabButton("วาร์ป", true, function() SwitchTab("Warp") end)
    TabSystem = CreateTabButton("ระบบ", false, function() SwitchTab("System") end)

    local function CreateWarpButton(text, cframePos)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -4, 0, 38)
        btn.BackgroundColor3 = Color3.fromRGB(12, 18, 30)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.TextXAlignment = Enum.TextXAlignment.Center
        btn.Parent = WarpContainer

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(0, 200, 230)
        stroke.Thickness = 1.5
        stroke.Parent = btn

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 30, 50)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 255)}):Play()
        end)

        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(12, 18, 30)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 200, 230)}):Play()
        end)

        btn.MouseButton1Click:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = cframePos
                SendNotification("เทเลพอร์ต", "เดินทางไป " .. text .. " สำเร็จ")
            end
        end)
        return btn
    end

    CreateWarpButton("ไปที่ประตู", CFrame.new(-36.11, 3.90, 111.03))
    CreateWarpButton("ไปที่ห้องพยาบาล", CFrame.new(-5.36, 3.98, -9.85))
    CreateWarpButton("ไปที่ลงทะเบียนผู้ป่วย", CFrame.new(16.99, 3.98, 110.50))
    CreateWarpButton("ไปที่ห้องไฟ", CFrame.new(-17.36, 3.83, 19.47))

    local speedEnabled = false
    local defaultSpeed = 16
    local targetSpeed = 50
    local speedConnection = nil

    local SpeedBtn = Instance.new("TextButton")
    SpeedBtn.Size = UDim2.new(1, -4, 0, 38)
    SpeedBtn.BackgroundColor3 = Color3.fromRGB(12, 18, 30)
    SpeedBtn.Text = "วิ่งเร็ว 50 : OFF"
    SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SpeedBtn.TextSize = 12
    SpeedBtn.Font = Enum.Font.GothamBold
    SpeedBtn.TextXAlignment = Enum.TextXAlignment.Center
    SpeedBtn.Parent = SystemContainer

    local SpeedBtnCorner = Instance.new("UICorner")
    SpeedBtnCorner.CornerRadius = UDim.new(0, 6)
    SpeedBtnCorner.Parent = SpeedBtn

    local SpeedBtnStroke = Instance.new("UIStroke")
    SpeedBtnStroke.Color = Color3.fromRGB(0, 200, 230)
    SpeedBtnStroke.Thickness = 1.5
    SpeedBtnStroke.Parent = SpeedBtn

    SpeedBtn.MouseEnter:Connect(function()
        if speedEnabled then
            TweenService:Create(SpeedBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 55, 45)}):Play()
            TweenService:Create(SpeedBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 200)}):Play()
        else
            TweenService:Create(SpeedBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 30, 50)}):Play()
            TweenService:Create(SpeedBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 255)}):Play()
        end
    end)

    SpeedBtn.MouseLeave:Connect(function()
        if speedEnabled then
            TweenService:Create(SpeedBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(15, 40, 30)}):Play()
            TweenService:Create(SpeedBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 150)}):Play()
        else
            TweenService:Create(SpeedBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(12, 18, 30)}):Play()
            TweenService:Create(SpeedBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 200, 230)}):Play()
        end
    end)

    local function toggleSpeed()
        speedEnabled = not speedEnabled
        if speedEnabled then
            SpeedBtn.Text = "วิ่งเร็ว 50 : ON"
            TweenService:Create(SpeedBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(15, 40, 30)}):Play()
            TweenService:Create(SpeedBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 255, 150)}):Play()
            
            speedConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Humanoid") then
                    char:FindFirstChildOfClass("Humanoid").WalkSpeed = targetSpeed
                end
            end)
            SendNotification("ระบบความเร็ว", "เปิดใช้งาน Speed 50 เรียบร้อย")
        else
            SpeedBtn.Text = "วิ่งเร็ว 50 : OFF"
            TweenService:Create(SpeedBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(12, 18, 30)}):Play()
            TweenService:Create(SpeedBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(0, 200, 230)}):Play()
            
            if speedConnection then speedConnection:Disconnect() end
            local char = LocalPlayer.Character
            if char and char:FindFirstChildOfClass("Humanoid") then
                char:FindFirstChildOfClass("Humanoid").WalkSpeed = defaultSpeed
            end
            SendNotification("ระบบความเร็ว", "ปิดการใช้งานแล้ว")
        end
    end

    SpeedBtn.MouseButton1Click:Connect(toggleSpeed)

    return MFrame
end

ToggleMenuBtn.MouseButton1Click:Connect(function()
    if not MainFrame or not MainFrame.Parent then
        MainFrame = CreateMainMenu()
        MainFrame.Visible = true
        TweenService:Create(ToggleMenuBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
        return
    end

    if RestoreBtn and RestoreBtn.Parent then
        RestoreBtn:Destroy()
        RestoreBtn = nil
        MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Position = UDim2.new(0.1, 0, 0.15, 0), Size = UDim2.new(0, 280, 0, 290)}):Play()
        TweenService:Create(ToggleMenuBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
        return
    end

    if MainFrame.Visible then
        MainFrame.Visible = false
        TweenService:Create(ToggleMenuBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    else
        MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.2), {Position = UDim2.new(0.1, 0, 0.15, 0), Size = UDim2.new(0, 280, 0, 290)}):Play()
        TweenService:Create(ToggleMenuBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
    end
